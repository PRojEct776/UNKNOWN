# =============================================================================
# UNKNOWN Environment Configuration Template
# Copy this file to .env and supply your credentials. No real secrets below.
# =============================================================================

# -----------------------------------------------------------------------------
# Primary LLM Provider: Google Gemini
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MODEL_NAME=gemini-2.5-flash
GEMINI_TIMEOUT_MS=120000
GEMINI_THINKING_LEVEL=LOW

# -----------------------------------------------------------------------------
# Secondary Fallback Providers
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# Provider fallback chain execution order
LLM_PROVIDER_ORDER=gemini,groq,cohere,openrouter,cloudflare
LLM_TIMEOUT_S=10.0

# -----------------------------------------------------------------------------
# Inference Generation Parameters
# -----------------------------------------------------------------------------
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=8192

# -----------------------------------------------------------------------------
# Web & Server Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173
VITE_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Storage & Document Upload Limits
# -----------------------------------------------------------------------------
MAX_COLLECTION_PAPERS=25
MAX_FILE_SIZE_BYTES=52428800
