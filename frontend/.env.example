# URL of the UNKNOWN backend API. Keep secrets out of VITE_* variables.
VITE_BACKEND_URL=http://localhost:8000

# Research query timeout in milliseconds (default: 30000 ms / 30 seconds for real multi-hop RAG).
VITE_BACKEND_TIMEOUT_MS=30000

# Fast timeout for health checks and lightweight status checks (default: 5000 ms).
VITE_FAST_TIMEOUT_MS=5000
